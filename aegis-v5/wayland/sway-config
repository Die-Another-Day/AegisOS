# AegisOS v5 sway config — Nebula-style floating desktop on sway 1.7.
# All windows float by default (Nebula's floating feel on a tiling compositor).
# No live blur in sway 1.7: panels use Pillow pre-blurred wallpaper slices
# (see ~/.config/aegis/blurred*.png, generated by aegis-colours.py).
set $mod Mod4
# Wallpaper (swaybg; reloaded by `aegis-wallpaper` after a switch)
output * bg ~/.config/aegis/wallpaper.png fill
# Floating-first: every window floats, centred, no title bars on the shell
floating_modifier $mod
default_border none
default_floating_border none
for_window [class=".*"] floating enable
for_window [app_id=".*"] floating enable
# Shell: lock screen first (reel: lid-open -> lock -> desktop), then desktop bar+widgets
exec /usr/local/bin/aegis-gui --lock-and-desktop
# Keybinds
bindsym $mod+space exec /usr/local/bin/aegis-shell --launcher
bindsym $mod+l exec /usr/local/bin/aegis-gui --lock
bindsym $mod+Return exec foot
bindsym $mod+d exec /usr/local/bin/aegis-shell --launcher
bindsym $mod+Shift+q kill
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -b 'Yes' 'swaymsg exit'
# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
# Idle: lock after 10 min (swayidle + swaylock with the rendered lock frame)
exec swayidle -w timeout 600 '/usr/local/bin/aegis-gui --secure-lock' before-sleep '/usr/local/bin/aegis-gui --secure-lock'
# Notifications
exec mako
