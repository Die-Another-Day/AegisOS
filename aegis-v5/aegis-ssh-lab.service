[Unit]
Description=AegisOS v5 lab SSH on port 2222 (LAB ONLY, private LAN only)
After=network.target
[Service]
Type=simple
RuntimeDirectory=sshd
ExecStart=/usr/sbin/sshd -D -p 2222 -o PermitRootLogin=no -o PasswordAuthentication=yes
Restart=on-failure
StandardOutput=journal
StandardError=journal
# NO [Install] section — on purpose. Same reason as aegis-labapp.service:
# systemd's first-boot preset population enables every unit with an
# [Install] section, which started lab SSH on 0.0.0.0:2222 at boot in v5
# repack #3 even though lab state was "disabled". Without [Install] this
# unit is static and starts only via an explicit `systemctl restart`
# from aegis-lab --enable / aegis-ir recover. See README-v5.md.
