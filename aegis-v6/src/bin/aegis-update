#!/usr/bin/env python3
"""aegis-update — patch-based updater for AegisOS v5.

  aegis-update                  same as `check`
  aegis-update check            installed version vs latest GitHub release
  aegis-update apply            apply the latest patch bundle if the release
                                carries one, else fetch the full image and
                                stop with flashing instructions
  aegis-update apply --bundle PATH   apply a local patch bundle (testing)
  aegis-update apply --url URL       apply a patch bundle from a URL (testing)

Patch bundles (format "aegis-patch/1") are small: only the files that
changed. A bundle is a .tar.gz holding manifest.json plus the files:

  {
    "format": "aegis-patch/1",
    "tag": "v5.0.2",
    "version": "5.0.2",
    "files": [
      {"path": "usr/local/bin/aegis-gui", "sha256": "<hex>", "mode": "755"}
    ],
    "post_apply": ["systemctl restart aegis.service"]
  }

  * "path" is relative to / — absolute paths and ".." are refused.
  * Every file's SHA256 is verified BEFORE anything is applied.
  * Every replaced file is backed up to /var/lib/aegis/backup/<old-version>/.
  * post_apply commands run only if they match a small allowlist
    (systemctl restart/reload of an aegis-*.service unit, or
    aegis-lab-reset-flags). Anything else refuses the whole bundle.
  * On any verification failure nothing is applied and exit is non-zero.

Full-image fallback: if the latest release has no patch bundle, the
updater downloads all aegis-v<major>.img.xz.part-* + SHA256SUMS.txt into
/var/lib/aegis/update/<tag>/, verifies every checksum, reassembles
the .xz and integrity-checks it with `xz -t` when xz is installed
(xz is not in the image, so that test is skipped there — the per-part
checksums already verified every downloaded byte) — then STOPS. It never
writes to the disk the running system booted from; the new image has
to be flashed to USB or attached as a new VM disk (instructions are
printed). Disk space needed for the download: ~1.5 GB free.

Needs root for `apply` (sudo). `check` works as any user. Network is
the GitHub API (api.github.com) plus release downloads; with no
network both commands fail with a clear message instead of a
traceback. Test hook: AEGIS_API_BASE overrides the API base URL
(default https://api.github.com) — used by the QEMU test rig to point
at a local fake API, never by normal use.
"""
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile

REPO = "Die-Another-Day/AegisOS"
API_BASE = os.environ.get("AEGIS_API_BASE", "https://api.github.com")
VERSION_FILE = "/etc/aegis-version"
UPDATE_DIR = "/var/lib/aegis/update"
BACKUP_DIR = "/var/lib/aegis/backup"
# Images before v5.0.2 shipped with no version file; they are all v5.0.
DEFAULT_VERSION = "5.0"
# A patch bundle for release <tag> is published as this asset name.
PATCH_ASSET = "{tag}-patch.tar.gz"
# Allowlist for manifest post_apply commands (run as root).
POST_APPLY_RE = re.compile(r"^systemctl (restart|reload) aegis(-[a-z0-9-]+)?\.service$")
POST_APPLY_EXACT = {"aegis-lab-reset-flags"}


def die(msg, code=1):
    print(f"aegis-update: {msg}", file=sys.stderr)
    sys.exit(code)


def read_installed():
    try:
        with open(VERSION_FILE) as f:
            v = f.read().strip()
        return v or DEFAULT_VERSION
    except OSError:
        # Missing (pre-5.0.2 image) or unreadable — report the base
        # version rather than crashing; check/apply still work.
        return DEFAULT_VERSION


def version_tuple(v):
    # Leading dotted numerics only; "5.0.2-test1" -> (5, 0, 2).
    m = re.match(r"(\d+(?:\.\d+)*)", v or "")
    if not m:
        return (0,)
    return tuple(int(x) for x in m.group(1).split("."))


def http_get_json(url):
    # curl, not urllib: --max-time bounds the WHOLE fetch including DNS,
    # which urllib's timeout does not (a dead DNS server can hang
    # getaddrinfo for minutes). A network failure returns None and the
    # caller prints a clear message instead of a traceback.
    try:
        r = subprocess.run(
            ["curl", "-fsSL", "--max-time", "15",
             "-H", "User-Agent: aegis-update",
             "-H", "Accept: application/vnd.github+json", url],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None
    if r.returncode != 0:
        return None
    try:
        data = json.loads(r.stdout)
    except ValueError:
        return None
    return data if isinstance(data, dict) else None


def get_latest_release():
    data = http_get_json(f"{API_BASE}/repos/{REPO}/releases/latest")
    if not isinstance(data, dict) or "tag_name" not in data:
        return None
    return data


def find_asset(release, name):
    for a in release.get("assets", []):
        if a.get("name") == name:
            return a
    return None


def download(url, dest):
    # curl with a hard wall-clock limit (covers DNS too).
    try:
        r = subprocess.run(
            ["curl", "-fsSL", "--max-time", "300",
             "-H", "User-Agent: aegis-update",
             "-o", dest, url],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            text=True, timeout=330)
    except (OSError, subprocess.SubprocessError) as e:
        die(f"download failed ({url}): {e}")
    if r.returncode != 0:
        die(f"download failed ({url}): curl exit {r.returncode}")


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1024 * 256), b""):
            h.update(chunk)
    return h.hexdigest()


def cmd_check():
    installed = read_installed()
    print(f"Installed version: {installed}")
    release = get_latest_release()
    if release is None:
        print("aegis-update: cannot reach the GitHub API "
              f"({API_BASE}) — check the network and try again.")
        return 1
    tag = release["tag_name"]
    latest = tag.lstrip("v")
    print(f"Latest release:    {tag}")
    cmp = (version_tuple(latest) > version_tuple(installed)) - \
          (version_tuple(latest) < version_tuple(installed))
    if cmp < 0:
        print(f"Installed {installed} is newer than the latest release "
              f"({tag}) — nothing to do.")
        return 0
    if cmp == 0:
        print("You are up to date.")
        return 0
    patch = find_asset(release, PATCH_ASSET.format(tag=tag))
    if patch:
        print(f"Update available: {tag} (patch bundle, "
              f"{patch.get('size', 0) // 1024} KiB) — run: sudo aegis-update apply")
    else:
        print(f"Update available: {tag} (full image only, ~400 MB download) "
              f"— run: sudo aegis-update apply")
    return 0


def _safe_relpath(p):
    # Manifest paths must be relative to / and contain no "..".
    if not p or os.path.isabs(p) or ".." in p.split("/"):
        return None
    return p


def verify_bundle(path):
    """Return (manifest, {relpath: bytes}) after full hash verification."""
    try:
        tf = tarfile.open(path, "r:gz")
    except (tarfile.TarError, OSError) as e:
        die(f"cannot open patch bundle {path}: {e}")
    try:
        try:
            m = tf.getmember("manifest.json")
        except KeyError:
            die("patch bundle has no manifest.json")
        manifest = json.loads(tf.extractfile(m).read().decode("utf-8"))
        if manifest.get("format") != "aegis-patch/1":
            die("patch bundle format is not aegis-patch/1")
        if not manifest.get("version") or not manifest.get("tag"):
            die("patch bundle manifest is missing version/tag")
        files = manifest.get("files") or []
        if not isinstance(files, list) or not files:
            die("patch bundle manifest lists no files")
        blobs = {}
        for entry in files:
            rel = _safe_relpath(entry.get("path", ""))
            if rel is None:
                die(f"patch bundle refuses unsafe path: {entry.get('path')!r}")
            if "sha256" not in entry:
                die(f"patch bundle entry {rel} has no sha256")
            try:
                member = tf.getmember(rel)
            except KeyError:
                die(f"patch bundle is missing file: {rel}")
            data = tf.extractfile(member).read()
            if hashlib.sha256(data).hexdigest() != entry["sha256"]:
                die(f"patch bundle hash mismatch for {rel} — refusing to apply")
            blobs[rel] = (data, entry.get("mode", "644"))
        for cmd in manifest.get("post_apply", []):
            if cmd in POST_APPLY_EXACT or POST_APPLY_RE.match(cmd):
                continue
            die(f"patch bundle post_apply command not allowed: {cmd!r}")
        return manifest, blobs
    finally:
        tf.close()


def apply_bundle(path, tag_hint=None):
    if os.geteuid() != 0:
        die("apply needs root — run: sudo aegis-update apply", code=2)
    manifest, blobs = verify_bundle(path)
    installed = read_installed()
    tag = manifest["tag"]
    version = manifest["version"]
    if version_tuple(version) <= version_tuple(installed) and not tag_hint:
        print(f"Installed {installed} is already at or newer than "
              f"{version} — nothing to apply.")
        return 0
    print(f"Applying patch {tag} (from {installed} to {version})...")
    backup_root = os.path.join(BACKUP_DIR, installed)
    os.makedirs(backup_root, exist_ok=True)
    applied = []
    try:
        for rel, (data, mode) in blobs.items():
            target = os.path.join("/", rel)
            os.makedirs(os.path.dirname(target), exist_ok=True)
            if os.path.exists(target) and not os.path.islink(target):
                backup = os.path.join(backup_root, rel)
                os.makedirs(os.path.dirname(backup), exist_ok=True)
                shutil.copy2(target, backup)
                print(f"  backed up {rel} -> {backup}")
            # Write via temp file + rename so a half-written file is
            # never left in place.
            fd, tmp = tempfile.mkstemp(dir=os.path.dirname(target) or "/",
                                       prefix=".aegis-update-")
            try:
                with os.fdopen(fd, "wb") as f:
                    f.write(data)
                os.chmod(tmp, int(str(mode), 8))
                os.replace(tmp, target)
            except BaseException:
                try:
                    os.unlink(tmp)
                except OSError:
                    pass
                raise
            applied.append(rel)
            print(f"  applied {rel}")
    except BaseException as e:
        print(f"aegis-update: apply failed halfway ({e}) — files already "
              f"applied: {applied}. Restores are in {backup_root}.", file=sys.stderr)
        return 1
    for cmd in manifest.get("post_apply", []):
        print(f"  post_apply: {cmd}")
        r = subprocess.run(cmd.split(), stdout=subprocess.PIPE,
                           stderr=subprocess.STDOUT, text=True, timeout=120)
        sys.stdout.write(r.stdout or "")
        if r.returncode != 0:
            print(f"aegis-update: post_apply failed ({cmd}) — version left "
                  f"at {installed}; restores are in {backup_root}.",
                  file=sys.stderr)
            return 1
    with open(VERSION_FILE, "w") as f:
        f.write(version + "\n")
    print(f"Done — AegisOS is now {version} (backups in {backup_root}).")
    return 0


def apply_full_image(release, tag):
    if os.geteuid() != 0:
        die("apply needs root — run: sudo aegis-update apply", code=2)
    dest_dir = os.path.join(UPDATE_DIR, tag)
    os.makedirs(dest_dir, exist_ok=True)
    assets = {a["name"]: a for a in release.get("assets", [])}
    # NOTE (found 2026-11-22, update-test-v6): the part regex was
    # hardcoded to `aegis-v5` — a v5 carry-over. v6 parts are named
    # `aegis-v6.img.xz.part-NN`, so the match was always empty and every
    # full-image fallback died with "no complete image parts". Derive
    # the major version from the release tag instead (v6.0.2 -> v6).
    major = tag.split(".")[0]
    parts = sorted(n for n in assets
                   if re.match(rf"aegis-{re.escape(major)}\.img\.xz\.part-\d+$", n))
    if not parts or "SHA256SUMS.txt" not in assets:
        die(f"release {tag} has no patch bundle and no complete image "
            f"parts — cannot update from this release")
    # Disk-space guard: parts (~405 MB) + reassembled .xz (~405 MB).
    free = shutil.disk_usage(dest_dir).free
    if free < 1500 * 1024 * 1024:
        die(f"not enough free space in {dest_dir} "
            f"({free // (1024 * 1024)} MiB free, need ~1500 MiB)")
    print(f"No patch bundle for {tag} — fetching the full image "
          f"({len(parts)} parts, ~400 MB) into {dest_dir} ...")
    for name in parts + ["SHA256SUMS.txt"]:
        dest = os.path.join(dest_dir, name)
        if os.path.exists(dest) and name != "SHA256SUMS.txt":
            print(f"  {name} already downloaded, skipping")
            continue
        print(f"  downloading {name} ...")
        download(assets[name]["browser_download_url"], dest)
    sums = os.path.join(dest_dir, "SHA256SUMS.txt")
    # Pure-Python verification (no shell-out): parse SHA256SUMS.txt and
    # check every listed part with hashlib. Prints "name: OK" per part.
    expected = {}
    for line in open(sums).read().splitlines():
        line = line.strip()
        if not line:
            continue
        h, _, name = line.partition(" ")
        expected[os.path.basename(name.strip().lstrip("*"))] = h.strip()
    for name in parts:
        if name not in expected:
            die(f"no checksum listed for {name}")
        got = sha256_file(os.path.join(dest_dir, name))
        if got != expected[name]:
            die(f"checksum mismatch for {name} — the download is corrupt; "
                f"delete {dest_dir} and try again")
        print(f"{name}: OK")
    joined = os.path.join(dest_dir, f"aegis-{major}.img.xz")
    with open(joined, "wb") as out:
        for name in parts:
            with open(os.path.join(dest_dir, name), "rb") as f:
                shutil.copyfileobj(f, out, length=1024 * 256)
    print("Verifying the reassembled image ...")
    if shutil.which("xz") is None:
        print("note: xz is not installed in this image, so the .xz integrity")
        print("test is skipped — the per-part checksums above already")
        print("verified every downloaded byte.")
    else:
        try:
            r = subprocess.run(["xz", "-t", joined], stdout=subprocess.PIPE,
                               stderr=subprocess.STDOUT, text=True, timeout=300)
        except (OSError, subprocess.SubprocessError) as e:
            die(f"could not run xz -t on the reassembled image: {e}")
        if r.returncode != 0:
            die(f"reassembled image failed integrity check: {r.stdout}")
    # Best-effort cross-check against the hash in the release notes.
    m = re.search(r"Compressed \.xz SHA256:\s*([0-9a-f]{64})",
                  release.get("body") or "")
    if m:
        got = sha256_file(joined)
        if got != m.group(1):
            die("reassembled image hash does not match the release notes — "
                "the download is corrupt")
        print(f"  reassembled .xz SHA256 matches the release notes: {got}")
    print(f"Image downloaded and verified: {joined} "
          f"({os.path.getsize(joined) // (1024 * 1024)} MiB)")
    print()
    print("STOP — the new image is staged, not installed.")
    print("AegisOS cannot overwrite the disk it booted from. To use it:")
    print("  * USB:  xz -d aegis-{}.img.xz && sudo dd if=aegis-{}.img "
          .format(major, major) +
          "of=/dev/sdX bs=4M status=progress")
    print("  * VM:   attach aegis-{}.img as a NEW virtual disk (keep the "
          .format(major) +
          "old one until the new one boots), or replace the disk file")
    print("          in a powered-off VM and boot it.")
    print("  * Then boot, log in as analyst, and run: aegis-update check")
    return 0


def cmd_apply(args):
    bundle = None
    url = None
    i = 0
    while i < len(args):
        if args[i] == "--bundle" and i + 1 < len(args):
            bundle, i = args[i + 1], i + 2
        elif args[i] == "--url" and i + 1 < len(args):
            url, i = args[i + 1], i + 2
        else:
            die(f"unknown argument: {args[i]}", code=2)
    if bundle:
        return apply_bundle(bundle, tag_hint="local")
    if url:
        if os.geteuid() != 0:
            die("apply needs root — run: sudo aegis-update apply", code=2)
        tmp = os.path.join(tempfile.gettempdir(), "aegis-patch.tar.gz")
        print(f"Downloading patch bundle from {url} ...")
        download(url, tmp)
        return apply_bundle(tmp, tag_hint="url")
    release = get_latest_release()
    if release is None:
        print("aegis-update: cannot reach the GitHub API "
              f"({API_BASE}) — check the network and try again.")
        return 1
    tag = release["tag_name"]
    installed = read_installed()
    if version_tuple(tag.lstrip("v")) <= version_tuple(installed):
        print(f"Installed {installed} is already at or newer than {tag} "
              f"— nothing to do.")
        return 0
    patch = find_asset(release, PATCH_ASSET.format(tag=tag))
    if patch:
        tmp = os.path.join(tempfile.gettempdir(), "aegis-patch.tar.gz")
        print(f"Downloading patch bundle {patch['name']} "
              f"({patch.get('size', 0) // 1024} KiB) ...")
        download(patch["browser_download_url"], tmp)
        return apply_bundle(tmp)
    return apply_full_image(release, tag)


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("check", "--check"):
        sys.exit(cmd_check())
    if args[0] == "apply":
        sys.exit(cmd_apply(args[1:]))
    if args[0] in ("--help", "-h", "help"):
        print(__doc__.strip())
        return 0
    die(f"unknown command: {args[0]} (try: aegis-update check | apply)", code=2)


if __name__ == "__main__":
    main()
