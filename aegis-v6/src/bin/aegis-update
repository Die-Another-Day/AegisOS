#!/usr/bin/env python3
"""aegis-update — full-image updater for AegisOS.

  aegis-update          same as `check`
  aegis-update check    installed version vs latest GitHub release
  aegis-update apply    fetch the latest full image and stop with
                        flashing instructions (as root)

The updater downloads the release's full image — the split
`aegis-v<major>.img.xz.part-*` assets plus `SHA256SUMS.txt` — and
stages it at /var/lib/aegis/update/<tag>/aegis-v<major>.img.xz. The
major version comes from the release tag (v6.0.0 -> v6), so a v5
system can fetch a v6 image. It never writes to the disk the running
system booted from; the new image has to be flashed to USB or
attached as a new VM disk (instructions are printed).

How the download works — like a real Linux/Windows updater. The old
code downloaded every part, kept them all, and only then combined
them into the .xz, which needed twice the download size on disk
(parts + reassembled file side by side):

  * Streaming: each part is downloaded, SHA256-verified against
    SHA256SUMS.txt, appended to the final .xz, and deleted. The
    final file grows as parts arrive; there is no separate combine
    step and parts never coexist with the finished file. Peak disk
    is the final file + one part, so the space guard is
    total + largest part + 100 MiB slack.
  * Resume: if the staged .xz already exists and verifies (size
    matches the release, and its SHA256 matches the hash in the
    release notes when one is published), `apply` skips the download
    entirely and just prints STOP again. A partial or corrupt staged
    file is deleted and the download is redone from scratch.

Patch bundles are gone. The `aegis-patch/1` bundle machinery
(`<tag>-patch.tar.gz`, manifest verification, post_apply allowlist,
--bundle/--url flags) was removed 2026-11-24: no patch bundle was
ever published for any release and no bundle builder was ever built,
so it was dead code. If a bundle builder is ever built, the
mechanism can be re-added.

Needs root for `apply` (sudo). `check` works as any user. Network is
the GitHub API (api.github.com) plus release downloads; with no
network both commands fail with a clear message instead of a
traceback. Test hook: AEGIS_API_BASE overrides the API base URL
(default https://api.github.com) — used by the QEMU test rig to point
at a local fake API, never by normal use.
"""
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys

REPO = "Die-Another-Day/AegisOS"
API_BASE = os.environ.get("AEGIS_API_BASE", "https://api.github.com")
VERSION_FILE = "/etc/aegis-version"
UPDATE_DIR = "/var/lib/aegis/update"
# Images before v5.0.2 shipped with no version file; they are all v5.0.
DEFAULT_VERSION = "5.0"


class UpdateError(Exception):
    """A failure inside apply_full_image. Raised instead of exiting so
    the caller can delete a half-streamed image before dying."""


def die(msg, code=1):
    print(f"aegis-update: {msg}", file=sys.stderr)
    sys.exit(code)


def read_installed():
    try:
        with open(VERSION_FILE) as f:
            v = f.read().strip()
        return v or DEFAULT_VERSION
    except OSError:
        # Missing (pre-5.0.2 image) or unreadable — report the base
        # version rather than crashing; check/apply still work.
        return DEFAULT_VERSION


def version_tuple(v):
    # Leading dotted numerics only; "5.0.2-test1" -> (5, 0, 2).
    m = re.match(r"(\d+(?:\.\d+)*)", v or "")
    if not m:
        return (0,)
    return tuple(int(x) for x in m.group(1).split("."))


def http_get_json(url):
    # curl, not urllib: --max-time bounds the WHOLE fetch including DNS,
    # which urllib's timeout does not (a dead DNS server can hang
    # getaddrinfo for minutes). A network failure returns None and the
    # caller prints a clear message instead of a traceback.
    try:
        r = subprocess.run(
            ["curl", "-fsSL", "--max-time", "15",
             "-H", "User-Agent: aegis-update",
             "-H", "Accept: application/vnd.github+json", url],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None
    if r.returncode != 0:
        return None
    try:
        data = json.loads(r.stdout)
    except ValueError:
        return None
    return data if isinstance(data, dict) else None


def get_latest_release():
    data = http_get_json(f"{API_BASE}/repos/{REPO}/releases/latest")
    if not isinstance(data, dict) or "tag_name" not in data:
        return None
    return data


def image_parts(release, tag):
    """(major, sorted part names, total bytes, assets-by-name) for a release's
    full image. Part assets are named aegis-v<major>.img.xz.part-NN, with
    the major version taken from the tag (v6.0.0 -> v6, v5.0.5 -> v5).
    Hardcoding `aegis-v5` (the old code) matched nothing in the v6.0.0
    release, so every v5->v6 `apply` died with "no complete image parts"."""
    major = tag.split(".")[0]
    assets = {a["name"]: a for a in release.get("assets", [])}
    parts = sorted(n for n in assets
                   if re.match(rf"aegis-{re.escape(major)}\.img\.xz\.part-\d+$", n))
    total = sum(assets[n].get("size", 0) for n in parts)
    return major, parts, total, assets


def release_notes_xz_hash(release, major):
    """SHA256 of the compressed .xz from the release notes, if published.
    Two formats are seen: the test fixtures' "Compressed .xz SHA256:
    <hex>" line, and the real release notes' "Compressed
    `aegis-v<major>.img.xz` (N parts):" followed by the hash in
    backticks on the next line. Returns None when no hash is found."""
    body = release.get("body") or ""
    m = re.search(r"Compressed \.xz SHA256:\s*([0-9a-f]{64})", body)
    if m:
        return m.group(1)
    m = re.search(r"Compressed `aegis-" + re.escape(major) +
                  r"\.img\.xz`[^`]*`([0-9a-f]{64})`", body, re.DOTALL)
    return m.group(1) if m else None


def staged_is_valid(path, total, release, major):
    """True only if the staged .xz is complete and verified: its size
    must match the release's part total, and its SHA256 must match the
    hash in the release notes when one is published (falling back to
    `xz -t` when xz exists — it does not in the image, so the notes
    hash is what normally decides). Anything unverifiable counts as
    invalid, so a later apply re-downloads rather than trusting it."""
    try:
        if os.path.getsize(path) != total:
            return False
    except OSError:
        return False
    notes_hash = release_notes_xz_hash(release, major)
    if notes_hash is not None:
        try:
            return sha256_file(path) == notes_hash
        except OSError:
            return False
    if shutil.which("xz") is not None:
        try:
            r = subprocess.run(["xz", "-t", path], stdout=subprocess.PIPE,
                               stderr=subprocess.STDOUT, text=True, timeout=300)
        except (OSError, subprocess.SubprocessError):
            return False
        return r.returncode == 0
    return False


def download(url, dest):
    # curl with a hard wall-clock limit (covers DNS too). Raises
    # UpdateError instead of exiting, so the caller can clean up a
    # half-streamed image before dying.
    try:
        r = subprocess.run(
            ["curl", "-fsSL", "--max-time", "300",
             "-H", "User-Agent: aegis-update",
             "-o", dest, url],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            text=True, timeout=330)
    except (OSError, subprocess.SubprocessError) as e:
        raise UpdateError(f"download failed ({url}): {e}")
    if r.returncode != 0:
        raise UpdateError(f"download failed ({url}): curl exit {r.returncode}")


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1024 * 256), b""):
            h.update(chunk)
    return h.hexdigest()


def cmd_check():
    installed = read_installed()
    print(f"Installed version: {installed}")
    release = get_latest_release()
    if release is None:
        print("aegis-update: cannot reach the GitHub API "
              f"({API_BASE}) — check the network and try again.")
        return 1
    tag = release["tag_name"]
    latest = tag.lstrip("v")
    print(f"Latest release:    {tag}")
    cmp = (version_tuple(latest) > version_tuple(installed)) - \
          (version_tuple(latest) < version_tuple(installed))
    if cmp < 0:
        print(f"Installed {installed} is newer than the latest release "
              f"({tag}) — nothing to do.")
        return 0
    if cmp == 0:
        print("You are up to date.")
        return 0
    # Full-image size from the release's own part sizes — the old
    # hardcoded "~400 MB" was the v5 image and wrong for v6 (~778 MB).
    _major, _parts, total, _assets = image_parts(release, tag)
    if _parts and total:
        print(f"Update available: {tag} (full image only, "
              f"~{total // (1024 * 1024)} MB download) "
              f"— run: sudo aegis-update apply")
    else:
        print(f"Update available: {tag} (full image only) "
              f"— run: sudo aegis-update apply")
    return 0


def print_stop(major, joined, already=False):
    if already:
        print(f"Image already staged and verified: {joined} "
              f"({os.path.getsize(joined) // (1024 * 1024)} MiB) — "
              f"skipping the download.")
    else:
        print(f"Image downloaded and verified: {joined} "
              f"({os.path.getsize(joined) // (1024 * 1024)} MiB)")
    print()
    print("STOP — the new image is staged, not installed.")
    print("AegisOS cannot overwrite the disk it booted from. To use it:")
    print("  * USB:  xz -d aegis-{}.img.xz && sudo dd if=aegis-{}.img "
          .format(major, major) +
          "of=/dev/sdX bs=4M status=progress")
    print("  * VM:   attach aegis-{}.img as a NEW virtual disk (keep the "
          .format(major) +
          "old one until the new one boots), or replace the disk file")
    print("          in a powered-off VM and boot it.")
    print("  * Then boot, log in as analyst, and run: aegis-update check")


def apply_full_image(release, tag):
    if os.geteuid() != 0:
        die("apply needs root — run: sudo aegis-update apply", code=2)
    dest_dir = os.path.join(UPDATE_DIR, tag)
    os.makedirs(dest_dir, exist_ok=True)
    major, parts, total, assets = image_parts(release, tag)
    if not parts or "SHA256SUMS.txt" not in assets:
        die(f"release {tag} has no complete image parts "
            f"— cannot update from this release")
    joined = os.path.join(dest_dir, f"aegis-{major}.img.xz")
    # Resume: a staged image that verifies is already done — do not
    # re-download it. (This is the case the user hit on 2026-11-23: a
    # second apply died on disk space although the image was staged.)
    if os.path.exists(joined):
        if staged_is_valid(joined, total, release, major):
            print_stop(major, joined, already=True)
            return 0
        print(f"Staged image {joined} is incomplete or corrupt — "
              f"deleting it and downloading again.")
        try:
            os.unlink(joined)
        except OSError:
            pass
    # Disk-space guard: the final file (total) + one part at a time
    # (largest part) + 100 MiB slack. The old guard needed twice the
    # download (parts + reassembled .xz kept side by side) — for v6
    # that was ~1656 MiB; streaming needs ~900 MiB.
    largest = max(assets[n].get("size", 0) for n in parts)
    need = total + largest + 100 * 1024 * 1024
    free = shutil.disk_usage(dest_dir).free
    if free < need:
        die(f"not enough free space in {dest_dir} "
            f"({free // (1024 * 1024)} MiB free, need ~{need // (1024 * 1024)} MiB)")
    print(f"Fetching the full image for {tag} "
          f"({len(parts)} parts, ~{total // (1024 * 1024)} MB, streamed) "
          f"into {dest_dir} ...")
    part_path = None
    try:
        print("  downloading SHA256SUMS.txt ...")
        download(assets["SHA256SUMS.txt"]["browser_download_url"],
                 os.path.join(dest_dir, "SHA256SUMS.txt"))
        # Pure-Python verification (no shell-out): parse SHA256SUMS.txt.
        expected = {}
        for line in open(os.path.join(dest_dir, "SHA256SUMS.txt")).read().splitlines():
            line = line.strip()
            if not line:
                continue
            h, _, name = line.partition(" ")
            expected[os.path.basename(name.strip().lstrip("*"))] = h.strip()
        # Stream: download one part, verify it, append it to the final
        # .xz, delete it. A part left over from an interrupted run is
        # reused when its hash matches, re-downloaded when it does not.
        with open(joined, "wb") as out:
            for name in parts:
                part_path = os.path.join(dest_dir, name)
                if name not in expected:
                    raise UpdateError(f"no checksum listed for {name}")
                if os.path.exists(part_path):
                    if sha256_file(part_path) == expected[name]:
                        print(f"  {name} already downloaded, appending")
                    else:
                        print(f"  {name} on disk is corrupt — re-downloading")
                        os.unlink(part_path)
                        print(f"  downloading {name} ...")
                        download(assets[name]["browser_download_url"], part_path)
                        if sha256_file(part_path) != expected[name]:
                            raise UpdateError(f"checksum mismatch for {name} — the download is corrupt")
                else:
                    print(f"  downloading {name} ...")
                    download(assets[name]["browser_download_url"], part_path)
                    if sha256_file(part_path) != expected[name]:
                        raise UpdateError(f"checksum mismatch for {name} — the download is corrupt")
                with open(part_path, "rb") as f:
                    shutil.copyfileobj(f, out, length=1024 * 256)
                os.unlink(part_path)
                print(f"{name}: OK")
        # Final check against the release-notes hash when one is
        # published (the per-part checksums already verified every
        # byte, so this is a second, independent source).
        notes_hash = release_notes_xz_hash(release, major)
        if notes_hash is not None:
            got = sha256_file(joined)
            if got != notes_hash:
                raise UpdateError("assembled image hash does not match the release notes — the download is corrupt")
            print(f"  assembled .xz SHA256 matches the release notes: {got}")
        elif shutil.which("xz") is not None:
            r = subprocess.run(["xz", "-t", joined], stdout=subprocess.PIPE,
                               stderr=subprocess.STDOUT, text=True, timeout=300)
            if r.returncode != 0:
                raise UpdateError(f"assembled image failed integrity check: {r.stdout}")
            print("  assembled .xz passed the integrity check (xz -t)")
        else:
            print("  note: no independent final check available (no xz, no "
                  "hash in the release notes) — the per-part checksums "
                  "already verified every downloaded byte.")
    except UpdateError as e:
        # Never leave a half-streamed image behind: the resume check
        # would reject it anyway, but deleting it now means the next
        # apply starts clean instead of re-verifying a corrupt file.
        for p in (joined, part_path):
            if p:
                try:
                    os.unlink(p)
                except OSError:
                    pass
        die(str(e))
    print_stop(major, joined, already=False)
    return 0


def cmd_apply(args):
    if args:
        die(f"unknown argument: {args[0]}", code=2)
    if os.geteuid() != 0:
        die("apply needs root — run: sudo aegis-update apply", code=2)
    release = get_latest_release()
    if release is None:
        print("aegis-update: cannot reach the GitHub API "
              f"({API_BASE}) — check the network and try again.")
        return 1
    tag = release["tag_name"]
    installed = read_installed()
    if version_tuple(tag.lstrip("v")) <= version_tuple(installed):
        print(f"Installed {installed} is already at or newer than {tag} "
              f"— nothing to do.")
        return 0
    return apply_full_image(release, tag)


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("check", "--check"):
        sys.exit(cmd_check())
    if args[0] == "apply":
        sys.exit(cmd_apply(args[1:]))
    if args[0] in ("--help", "-h", "help"):
        print(__doc__.strip())
        return 0
    die(f"unknown command: {args[0]} (try: aegis-update check | apply)", code=2)


if __name__ == "__main__":
    main()
