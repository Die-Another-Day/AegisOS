# aegis.script — AegisOS Plymouth boot theme (text-only).
#
# Centred "AegisOS" text fading in and out over a twinkling
# starfield, in the style of the stock fade-in theme. No image files:
# the title and the stars are rendered from text, so the theme works
# with nothing but this script.
#
# Logo slot: if logo.png exists in this theme directory (the build
# installs it as a symlink to /usr/share/aegis/logo.png), the logo is
# shown centred above the title, scaled to at most 240 px wide. If
# there is no logo file yet, the theme is text-only and nothing breaks
# (Image() returns null for a missing file, and the null check below
# skips the logo entirely).
#
# API notes (Plymouth script plugin, as in the stock script theme):
#   Image.Text(text, red, green, blue, alpha, font, align) renders
#   text with a Pango font description ("Sans Bold 64").
#   Image("logo.png") loads from this theme's ImageDir; a missing
#   file yields null, which is falsy in `if`.
#   Math.Random() / Math.Int() / Math.Cos() / Math.Sin() are provided
#   by the script math library.

Window.SetBackgroundTopColor (0.02, 0.03, 0.09);
Window.SetBackgroundBottomColor (0.05, 0.07, 0.16);

status = "normal";
tick = 0;

# --- Title ---------------------------------------------------------------
title.image = Image.Text ("AegisOS", 0.96, 0.93, 0.85, 1, "Sans Bold 64");
title.sprite = Sprite (title.image);
title.angle = 0;
title.x = Window.GetX() + Window.GetWidth() / 2 - title.image.GetWidth() / 2;
title.y = Window.GetY() + Window.GetHeight() * 0.42 - title.image.GetHeight() / 2;
title.sprite.SetPosition (title.x, title.y, 10);

# --- Logo (optional; see the header comment) -----------------------------
logo.image = Image ("logo.png");
if (logo.image)
  {
    if (logo.image.GetWidth() > 240)
      logo.image = logo.image.Scale (240, logo.image.GetHeight() * 240 / logo.image.GetWidth());
    logo.sprite = Sprite (logo.image);
    logo.x = Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
    logo.y = title.y - logo.image.GetHeight() - 28;
    logo.sprite.SetPosition (logo.x, logo.y, 10);
  }

# --- Stars ---------------------------------------------------------------
# A few shared star glyphs; each star picks one at random, so the
# field costs four tiny text images, not one per star.
star_images[0] = Image.Text ("*", 1, 1, 1, 1, "Sans Bold 6");
star_images[1] = Image.Text ("*", 1, 1, 1, 1, "Sans Bold 9");
star_images[2] = Image.Text ("*", 1, 1, 1, 1, "Sans Bold 13");
star_images[3] = Image.Text ("*", 0.85, 0.9, 1, 1, "Sans Bold 9");

for (i = 0; i < 42; i++)
  {
    stars[i].image = star_images[Math.Int (Math.Random () * 4)];
    stars[i].sprite = Sprite (stars[i].image);
    stars[i].x = Window.GetX() + Math.Random () * Window.GetWidth();
    stars[i].y = Window.GetY() + Math.Random () * Window.GetHeight();
    stars[i].phase = Math.Random () * 6.28;
    stars[i].speed = 0.4 + Math.Random () * 1.6;
    stars[i].sprite.SetPosition (stars[i].x, stars[i].y, 1);
  }

# --- Refresh: title fade + star twinkle ----------------------------------
fun refresh_callback ()
  {
    tick++;
    if (status == "normal")
      {
        title.angle += ((2 * 3.14) / 50) * 0.5;  # 0.5 Hz, stock fade-in rate
        opacity = (Math.Cos (title.angle) + 1) / 2;
        opacity *= 0.65;
        opacity += 0.35;
        title.sprite.SetOpacity (opacity);
        if (logo.sprite)
          logo.sprite.SetOpacity (opacity);
      }
    for (i = 0; stars[i]; i++)
      {
        star_opacity = 0.2 + 0.7 * (0.5 + 0.5 * Math.Sin (tick * 0.05 * stars[i].speed + stars[i].phase));
        stars[i].sprite.SetOpacity (star_opacity);
      }
  }

Plymouth.SetRefreshFunction (refresh_callback);

# --- Password prompt (disk unlock) ---------------------------------------
# Text-only: the prompt is rendered as text and the typed password
# shows as a centred row of "*" bullets. No box/lock/entry images.
fun display_normal_callback ()
  {
    global.status = "normal";
    if (dialog.prompt_sprite)
      dialog.prompt_sprite.SetOpacity (0);
    for (index = 0; dialog.bullet[index]; index++)
      dialog.bullet[index].sprite.SetOpacity (0);
  }

fun display_password_callback (prompt, bullets)
  {
    global.status = "password";
    title.sprite.SetOpacity (0);
    if (logo.sprite)
      logo.sprite.SetOpacity (0);
    if (!dialog.prompt_sprite)
      {
        dialog.prompt_sprite = Sprite ();
        dialog.bullet_image = Image.Text ("*", 1, 1, 1, 1, "Sans Bold 20");
      }
    dialog.prompt_image = Image.Text (prompt, 1, 1, 1, 1, "Sans 20");
    dialog.prompt_sprite.SetImage (dialog.prompt_image);
    dialog.prompt_sprite.SetPosition (Window.GetX() + Window.GetWidth() / 2 - dialog.prompt_image.GetWidth() / 2,
                                      Window.GetY() + Window.GetHeight() * 0.45 - dialog.prompt_image.GetHeight() / 2,
                                      20);
    dialog.prompt_sprite.SetOpacity (1);
    for (index = 0; dialog.bullet[index] || index < bullets; index++)
      {
        if (!dialog.bullet[index])
          dialog.bullet[index].sprite = Sprite (dialog.bullet_image);
        dialog.bullet[index].sprite.SetPosition (Window.GetX() + Window.GetWidth() / 2 - bullets * dialog.bullet_image.GetWidth() / 2 + index * dialog.bullet_image.GetWidth(),
                                                 Window.GetY() + Window.GetHeight() * 0.45 + dialog.prompt_image.GetHeight(),
                                                 21);
        if (index < bullets)
          dialog.bullet[index].sprite.SetOpacity (1);
        else
          dialog.bullet[index].sprite.SetOpacity (0);
      }
  }

Plymouth.SetDisplayNormalFunction (display_normal_callback);
Plymouth.SetDisplayPasswordFunction (display_password_callback);

# --- Boot messages ---------------------------------------------------------
message_sprite = Sprite ();
message_sprite.SetPosition (10, 10, 10000);

fun display_message_callback (text)
  {
    message_image = Image.Text (text, 0.8, 0.8, 0.85, 1, "Sans 16");
    message_sprite.SetImage (message_image);
  }

fun hide_message_callback (text)
  {
    message_sprite = Sprite ();
    message_sprite.SetPosition (10, 10, 10000);
  }

Plymouth.SetDisplayMessageFunction (display_message_callback);
Plymouth.SetHideMessageFunction (hide_message_callback);

# --- Quit: leave the title fully visible as the desktop takes over -------
fun quit_callback ()
  {
    title.sprite.SetOpacity (1);
    if (logo.sprite)
      logo.sprite.SetOpacity (1);
  }

Plymouth.SetQuitFunction (quit_callback);
